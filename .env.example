# From https://discord.com/developers/applications -> your app -> OAuth2
# Used by `npm run dev` (Vite and the local Worker both read this file) and baked into `npm run build`.
VITE_DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Optional: browser-only test logins (no Discord). Default: on for localhost, off when deployed.
# ALLOW_DEV_LOGIN=false
