{
  "name": "settleon",
  "version": "0.1.0",
  "private": true,
  "description": "SettleOn - a multiplayer 3D pixel-art island you explore together, running as a Discord Activity",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"vite\" \"node --watch server/server.js\"",
    "build": "vite build",
    "start": "node server/server.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
